generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id Int @id @default(autoincrement())
  fullname String
  phone String @unique
  age Int
  password String
}

model Teacher{
  id Int @id @default(autoincrement())
  fullname String
  phone String @unique
  age Int
  password String
  experience Int
  @@map("teacher")
}

model Student{
  id Int @id @default(autoincrement())
  fullname String
  phone String @unique
  age Int
  password String

  @@map("students")
}